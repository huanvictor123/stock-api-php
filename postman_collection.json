						}
					}
				}
			]
		},
		{
			"name": "Sales",
			"item": [
				{
					"name": "POST Create Sale",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customer_name\": \"Maria Oliveira\",\n  \"customer_email\": \"maria@email.com\",\n  \"items\": [\n    {\"product_id\": 1, \"quantity\": 2},\n    {\"product_id\": 2, \"quantity\": 1}\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/sales",
							"host": ["{{base_url}}"],
							"path": ["sales"]
						}
					}
				},
				{
					"name": "GET Sale by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/sales/1",
							"host": ["{{base_url}}"],
							"path": ["sales", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Reports",
			"item": [
				{
					"name": "GET Low Stock",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
